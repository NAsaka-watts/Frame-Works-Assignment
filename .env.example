# Environment Configuration for COVID-19 Research Analyzer
# Copy this file to .env and update the values as needed

# Application Settings
COVID_ANALYZER_TITLE="COVID-19 Research Analyzer"
COVID_ANALYZER_ICON="🦠"
COVID_ANALYZER_LAYOUT="wide"
COVID_ANALYZER_ENVIRONMENT="development"
COVID_ANALYZER_DEBUG="true"

# Server Settings
COVID_ANALYZER_HOST="localhost"
COVID_ANALYZER_PORT="8501"

# Data Settings
COVID_ANALYZER_MAX_FILE_SIZE_MB="500"
COVID_ANALYZER_SAMPLE_SIZE="100"
COVID_ANALYZER_TOP_JOURNALS="10"
COVID_ANALYZER_TOP_KEYWORDS="100"
COVID_ANALYZER_MAX_UPLOAD_MB="100"
COVID_ANALYZER_ALLOWED_TYPES="csv"

# Performance Settings
COVID_ANALYZER_ENABLE_CACHING="true"
COVID_ANALYZER_CACHE_TTL="3600"
COVID_ANALYZER_MEMORY_THRESHOLD_MB="1000"
COVID_ANALYZER_ENABLE_SAMPLING="true"
COVID_ANALYZER_SAMPLE_SIZE_DEFAULT="10000"

# UI Settings
COVID_ANALYZER_SIDEBAR_STATE="expanded"
COVID_ANALYZER_THEME="light"
COVID_ANALYZER_SHOW_DEBUG="false"

# Logging Settings
COVID_ANALYZER_LOG_LEVEL="INFO"
COVID_ANALYZER_LOG_FORMAT="%(asctime)s - %(name)s - %(levelname)s - %(message)s"
COVID_ANALYZER_STRUCTURED_LOGGING="true"

# Health Check Settings
COVID_ANALYZER_HEALTH_CHECK="true"
COVID_ANALYZER_HEALTH_ENDPOINT="/health"

# Database Settings (Optional)
DB_HOST="localhost"
DB_PORT="5432"
DB_NAME="covid_analyzer"
DB_USER="postgres"
DB_PASSWORD=""
DB_SSL_MODE="prefer"
DB_TIMEOUT="30"

# Redis Settings (Optional)
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""
REDIS_DB="0"
REDIS_SSL="false"
REDIS_TIMEOUT="5"

# Cloud Storage Settings (Optional)
CLOUD_STORAGE_PROVIDER="local"
CLOUD_STORAGE_BUCKET=""
CLOUD_STORAGE_REGION="us-east-1"
CLOUD_STORAGE_ACCESS_KEY=""
CLOUD_STORAGE_SECRET_KEY=""
CLOUD_STORAGE_ENDPOINT=""

# Security Settings
STREAMLIT_SERVER_ENABLE_CORS="false"
STREAMLIT_SERVER_ENABLE_XSRF_PROTECTION="true"
STREAMLIT_BROWSER_GATHER_USAGE_STATS="false"

# Development Settings
STREAMLIT_GLOBAL_DEVELOPMENT_MODE="true"
STREAMLIT_RUNNER_MAGIC_ENABLED="true"
STREAMLIT_RUNNER_INSTALL_TRACER="true"